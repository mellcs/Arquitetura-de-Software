generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Payment {
  id        String   @id @default(uuid())
  pedidoId  String
  valor     Float
  status    String
  meios     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
